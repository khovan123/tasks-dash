{
  "name": "tasks-dash",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w @tasks-dash/contracts && npm run build -w @tasks-dash/api && npm run build -w @tasks-dash/web",
    "lint": "npm run lint -ws --if-present",
    "typecheck": "npm run typecheck -ws --if-present",
    "test": "npm run test -ws --if-present",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@dicebear/core": "^10.4.0",
    "@dicebear/styles": "^10.3.0"
  }
}

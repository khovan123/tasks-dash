COOKIE_DOMAIN=.example.com
SESSION_SECRET=replace-with-at-least-32-random-characters
INTEGRATION_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
WORKSPACE_BOOTSTRAP_SECRET=replace-with-at-least-32-random-characters
INVITE_TTL_HOURS=72
RESEND_API_KEY=
INVITE_EMAIL_FROM=Tasks Dash <invite@example.com>
SWAGGER_ENABLED=false

GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

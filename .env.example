NODE_ENV=development
WEB_PORT=3000
API_PORT=4000
MONGODB_URI=mongodb://localhost:27017/tasks-dash
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
TASKS_DASH_API_BASE_URL=http://localhost:4000/api

# GitHub App / webhook
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=

# Discord
DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=

# Google Drive OAuth/service account
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:4000/api/integrations/google-drive/callback
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=

# Demo mode keeps the UI functional without external credentials.
INTEGRATION_DEMO_MODE=true

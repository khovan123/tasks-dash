NODE_ENV=production
API_PORT=4000
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/tasks-dash?retryWrites=true&w=majority
MONGODB_MIN_POOL_SIZE=2
MONGODB_MAX_POOL_SIZE=20

WEB_APP_URL=https://app.example.com
API_PUBLIC_URL=https://api.example.com
NEXT_PUBLIC_API_BASE_URL=https://api.example.com/api
TASKS_DASH_API_BASE_URL=https://api.example.com/api
COOKIE_DOMAIN=.example.com
SESSION_SECRET=replace-with-at-least-32-random-characters
INTEGRATION_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
WORKSPACE_BOOTSTRAP_SECRET=replace-with-at-least-32-random-characters
INVITE_TTL_HOURS=72
SWAGGER_ENABLED=false

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_ALLOW_INSECURE=false
SMTP_USERNAME=invite@example.com
SMTP_PASSWORD=store-only-in-secret-manager
SMTP_FROM=Tasks Dash <invite@example.com>
SMTP_HELO_NAME=api.example.com
SMTP_CONNECTION_TIMEOUT_MS=10000

GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=https://api.example.com/api/auth/github/callback

GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_APP_PRIVATE_KEY=

DISCORD_APPLICATION_ID=
DISCORD_BOT_TOKEN=

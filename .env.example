NODE_ENV=production
API_PORT=4000
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/tasks-dash?retryWrites=true&w=majority
MONGODB_MIN_POOL_SIZE=2
MONGODB_MAX_POOL_SIZE=20

# Public production URLs. No localhost values in production.
WEB_APP_URL=https://app.example.com
API_PUBLIC_URL=https://api.example.com
NEXT_PUBLIC_API_BASE_URL=https://api.example.com/api
TASKS_DASH_API_BASE_URL=https://api.example.com/api
COOKIE_DOMAIN=.example.com
SESSION_SECRET=replace-with-at-least-32-random-characters
INTEGRATION_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
SWAGGER_ENABLED=false

# GitHub user authorization. Use the client credentials of the same GitHub App.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=https://api.example.com/api/auth/github/callback

# GitHub App installation authentication and webhooks.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_WEBHOOK_SECRET=
# Prefer base64 so PEM newlines survive secret managers.
GITHUB_APP_PRIVATE_KEY_BASE64=
# Alternative to the base64 value above:
GITHUB_APP_PRIVATE_KEY=

# Google Drive OAuth 2.0.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=https://api.example.com/api/integrations/google-drive/callback
